# PostgreSQL (use a unique secret outside local development)
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://osint:change-me@localhost:5432/osint
# Optional: enables live PostgreSQL repository/pgvector integration tests
TEST_DATABASE_URL=postgresql+asyncpg://osint:change-me@localhost:5432/osint

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Connector execution
MOCK_CONNECTORS=false
# Optional public GitHub API authentication; never paste tokens into chat.
GITHUB_TOKEN=
CONNECTOR_CONCURRENCY=4
CONNECTOR_TIMEOUT_SECONDS=30

# Investigation limits
MAX_PIVOT_DEPTH=3
MAX_CANDIDATES=100
MAX_CONNECTOR_RUNS=30
MAX_QUESTIONS=3
MAX_SEARCH_DURATION_SECONDS=600

# SQLAlchemy
DATABASE_ECHO=false
