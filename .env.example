# PostgreSQL
POSTGRES_DB=deus
POSTGRES_USER=deus
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://deus:change-me@localhost:5432/deus
# Optional: for isolated PostgreSQL integration tests
TEST_DATABASE_URL=postgresql+asyncpg://deus:change-me@localhost:5432/deus

# API
API_HOST=127.0.0.1
API_PORT=8765
LOG_LEVEL=INFO

# GitHub public API token (no scopes needed — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Gemini AI investigation adviser
# Get a free key at: https://aistudio.google.com/app/apikey
# Only pivot metadata is sent to Gemini — no personal data, no bios, no URLs.
GEMINI_API_KEY=
AI_ADVISER_ENABLED=false
AI_MODEL=gemini-2.5-flash

# Connector execution
TEXT_EMBEDDINGS_ENABLED=true
CONNECTOR_CONCURRENCY=4
CONNECTOR_TIMEOUT_SECONDS=30

# Investigation limits
MAX_PIVOT_DEPTH=5
DISCOVERY_TIMEOUT_SECONDS=60
# Reviewed Osintgram checkout, isolated Python, and explicit private (0600) session export.
OSINTGRAM_ENABLED=true
OSINTGRAM_PYTHON=
OSINTGRAM_SOURCE=
OSINTGRAM_SESSION_FILE=
MAX_CANDIDATES=60
MAX_CONNECTOR_RUNS=45
MAX_QUESTIONS=3
MAX_SEARCH_DURATION_SECONDS=600

# SQLAlchemy
DATABASE_ECHO=false
# Optional defensive integrations; never insert real secrets in this example.
GHUNT_ENABLED=false
GHUNT_AUTH_READY=false
GHUNT_PYTHON=
GITFIVE_ENABLED=false
GITFIVE_AUTH_READY=false
GITFIVE_BINARY=gitfive
GITFIVE_PYTHON=
HIBP_ENABLED=false
HIBP_API_KEY=
